{
  "name": "microstar-parent",
  "private": true,
  "version": "0.1.0",
  "description": "微动星瞳 · 家长端（iPad）",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
