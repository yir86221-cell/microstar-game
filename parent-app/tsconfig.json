{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vitest/globals"],
    "paths": {
      "@microstar/core-protocol": ["packages/core-protocol/src/index.ts"],
      "@microstar/core-domain": ["packages/core-domain/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "vitest.config.ts"
  ]
}
