# 必填：阿里云 AccessKey（建议用只授权 OSS + 视觉智能的子账号，不要用主账号）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 必填：一个用来中转照片的 OSS 桶（私有，不要开公共读）
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-shanghai

# 可选：视觉智能的服务入口和要调的能力
ALIYUN_ENDPOINT=imageseg.cn-shanghai.aliyuncs.com
ALIYUN_ACTION=SegmentCommonImage

# 可选：服务端口
PORT=8787

# 可选：简单口令。设了之后请求必须带 x-extract-token 头
SHARED_TOKEN=
