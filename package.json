{
  "name": "microstar-game-demo",
  "version": "0.1.0",
  "private": true,
  "description": "微动星瞳儿童端游戏交互 Demo",
  "scripts": {
    "dev": "node preview.mjs",
    "check": "node --check dist/game.js && node --check preview.mjs && node --check scripts/build-android.cjs",
    "test": "node scripts/check-game.cjs",
    "build:parent": "node scripts/build-parent.cjs && node scripts/package-parent.cjs",
    "android:sync": "npm run build:parent && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-android.cjs",
    "android:open": "cap open android"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
